APP_ENV=development
DATABASE_PATH=data/sabai.db
DEFAULT_PROVIDER=mock
# After configuring QWEN_* and KIMI_*, use DEFAULT_PROVIDER=companion
# for Qwen drafting + Kimi refinement with recorded single-model fallback.
SESSION_HOURS=168
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=
# Optional semantic recall; otherwise timestamped recent conversations remain available.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
CHAT_TURNS_PER_MINUTE=8
CHAT_TURNS_PER_DAY=200
# Fortune report writer: existing provider credentials; no Roxy subscription.
FORTUNE_PROVIDER=qwen
FORTUNE_REPORTS_PER_MINUTE=3
FORTUNE_REPORTS_PER_DAY=12
FORTUNE_NETWORK_REPORTS_PER_DAY=120
# Server-only Roxy credentials. Never use a VITE_ prefix.
ROXY_API_KEY=
ROXY_ENABLED=false
# Set roxy after configuring the key; github remains available as an independent test source.
BAZI_PROVIDER=github
ROXY_REQUESTS_PER_MINUTE=12
ROXY_REQUESTS_PER_DAY=80
# Theme-specific Bazi writing uses existing model credentials.
BAZI_REPORT_PROVIDER=qwen
# Test-stage report generation: 0 means unlimited; positive values enable a cap.
BAZI_REPORTS_PER_MINUTE=0
BAZI_REPORTS_PER_DAY=0
# Payso Demo merchant only. Leave empty to use the existing payment demonstration.
PAYSO_TEST_MERCHANT_ID=
PAYSO_TEST_API_KEY=
PAYSO_TEST_SECRET_KEY=

# Development-only Sunlands integration: creates an order, never submits a payment.
SUNLANDS_ORDER_ONLY=false
SUNLANDS_BASE_URL=https://api-prod.sunlands.com
SUNLANDS_APP_KEY=sunlands_fb_fate
SUNLANDS_APP_SECRET=
# Unset or empty omits channelCode for the gateway default; only override with a platform-confirmed channel.
# SUNLANDS_CHANNEL_CODE=
SUNLANDS_ITEM_NO=193261112000101
SUNLANDS_PRODUCT_NO=1932611120001
SUNLANDS_ITEM_TITLE=测试产品包
# externalCreateOrder uses the current user's mobile and nationCode from H5.
# Use the product center's sale-region ID, not a time zone or visitor ID.
SUNLANDS_PROVINCE_ID=
# Registered API gateway URI forwarding to /api/life-reports/payment/sunlands/notify.
# Grant sunlands_finance_trade access to that URI; grant this APP queryOrderDetailInfo access.
# Leave empty until registered. Existing orders can still be verified through payment/check.
SUNLANDS_MERCHANT_NOTIFY_URI=
# Reserved for a later LINE / LIFF integration. No LINE login in this starter.
LIFF_ID=
# Optional support email displayed by the existing H5 support page.
FATE_SUPPORT_EMAIL=
