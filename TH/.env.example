APP_ENV=development
# Optional Flutter SDK for H5 when it needs a different version from the App.
FATE_H5_FLUTTER_BIN=
DATABASE_URL=
# Optional name of the existing local PostgreSQL container for the unified launcher.
FATE_POSTGRES_CONTAINER=
DEFAULT_PROVIDER=mock
# After configuring QWEN_* and KIMI_*, use DEFAULT_PROVIDER=companion
# for Qwen drafting + Kimi refinement with recorded single-model fallback.
SESSION_HOURS=168
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Optional server-side transport for local development; leave empty on a server with direct access.
OPENAI_PROXY_URL=
# For models supporting reasoning_effort (for example gpt-5.4-mini): none or low.
OPENAI_REASONING_EFFORT=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=
# Optional semantic recall; otherwise timestamped recent conversations remain available.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
CHAT_TURNS_PER_MINUTE=8
CHAT_TURNS_PER_DAY=200
# Report prose uses the configured model; calculations are selected separately below.
# H5 OpenAI setup: FORTUNE_PROVIDER=openai, OPENAI_MODEL=gpt-6.1-sol,
# OPENAI_REASONING_EFFORT=low and server-only OPENAI_API_KEY. Keep LIFE_ASTROLOGY_PROVIDER=roxy.
FORTUNE_PROVIDER=qwen
# Optional H5 service-error failover when OpenAI is primary. Uses existing server-only QWEN_* settings.
FORTUNE_FALLBACK_PROVIDER=
# Optional OpenAI override for free Roxy previews. Leave the model empty to inherit OPENAI_MODEL.
LIFE_PREVIEW_OPENAI_MODEL=
LIFE_PREVIEW_OPENAI_REASONING_EFFORT=
# Comma-separated language codes. Leave empty to use the override for all supported languages.
LIFE_PREVIEW_OPENAI_LANGUAGES=
FORTUNE_REPORTS_PER_MINUTE=3
FORTUNE_REPORTS_PER_DAY=12
FORTUNE_NETWORK_REPORTS_PER_DAY=120
# Server-only Roxy credentials. Never use a VITE_ prefix.
ROXY_API_KEY=
ROXY_ENABLED=false
# New landing-page reports: roxy = Western tropical/Placidus; thai = existing Thai reports.
# Roxy requires ROXY_ENABLED=true and a server-only ROXY_API_KEY. No silent fallback.
LIFE_ASTROLOGY_PROVIDER=roxy
# Per-network allowance for the report creation/listing endpoint; other API paths retain their limit.
LIFE_REQUESTS_PER_MINUTE=120
# Persist preview work and bound calculation/model work independently.
LIFE_GENERATION_CONCURRENCY=32
LIFE_CHART_CONCURRENCY=8
# Set roxy after configuring the key; github remains available as an independent test source.
BAZI_PROVIDER=github
ROXY_REQUESTS_PER_MINUTE=240
ROXY_REQUESTS_PER_DAY=1000
# Theme-specific Bazi writing uses existing model credentials.
BAZI_REPORT_PROVIDER=qwen
# APP only: source audit -> report writing -> final audit; H5 keeps its existing pipeline.
WESTERN_REPORT_PROVIDER=qwen
# Optional role-specific model; empty uses the provider's *_MODEL setting.
WESTERN_REPORT_MODEL=
WESTERN_REVIEW_ENABLED=false
WESTERN_REVIEW_PROVIDER=kimi
WESTERN_REVIEW_MODEL=
# Optional, explicitly configured independent provider on service failure only.
# A review rejection NEVER triggers a second provider to override the decision.
WESTERN_REVIEW_FALLBACK_PROVIDER=
WESTERN_REVIEW_FALLBACK_MODEL=
# Test-stage report generation: 0 means unlimited; positive values enable a cap.
BAZI_REPORTS_PER_MINUTE=0
BAZI_REPORTS_PER_DAY=0
# Payso Demo merchant only. Leave empty to use the existing payment demonstration.
PAYSO_TEST_MERCHANT_ID=
PAYSO_TEST_API_KEY=
PAYSO_TEST_SECRET_KEY=
# Default LINE delivery does not offer checkout. Enable only for a configured checkout flow.
H5_CHECKOUT_ENABLED=false

# Explicit paid production mode: requires APP_ENV=production, SUNLANDS_ORDER_ONLY=true,
# a merchant contact, gateway credentials, sale region and the HTTPS report return page.
SUNLANDS_PAYMENT_REQUIRED=false
# Sunlands hosted checkout. Order creation, redirects and callbacks never prove payment.
# The backend verifies the original order, merchant, currency and full amount before unlocking.
SUNLANDS_ORDER_ONLY=false
SUNLANDS_BASE_URL=https://api-prod.sunlands.com
SUNLANDS_APP_KEY=sunlands_fb_fate
SUNLANDS_APP_SECRET=
# Unset or empty omits channelCode for the gateway default; only override with a platform-confirmed channel.
# SUNLANDS_CHANNEL_CODE=
SUNLANDS_ITEM_NO=193261112000101
SUNLANDS_PRODUCT_NO=1932611120001
SUNLANDS_ITEM_TITLE=测试产品包
# JY checkout uses this merchant contact when H5 sends no contact fields.
# The existing mobile/nationCode request contract is also accepted when explicitly supplied.
SUNLANDS_ORDER_MOBILE=
SUNLANDS_ORDER_NATION_CODE=86
# Use the product center's sale-region ID, not a time zone or visitor ID.
SUNLANDS_PROVINCE_ID=
# Registered API gateway URI forwarding to /api/life-reports/payment/sunlands/notify.
# Grant sunlands_finance_trade access to that URI; grant this APP queryOrderDetailInfo access.
# Leave empty until registered. Existing orders can still be verified through payment/check.
SUNLANDS_MERCHANT_NOTIFY_URI=
# Same-origin public report.html URL, without query or fragment; never a third-party return URL.
# The development launcher derives the local H5 preview URL when checkout is enabled.
SUNLANDS_H5_RETURN_URL=
# Reserved for a later LINE / LIFF integration. No LINE login in this starter.
LIFF_ID=
# Optional support email displayed by the existing H5 support page.
FATE_SUPPORT_EMAIL=
# H5 operations at /admin/. Disabled until both values are configured.
# Generate the hash with backend.app.accounts.password_hash; never commit a real password or hash.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Optional separate account for LINE report delivery at /admin/.
REPORT_SUPPORT_USERNAME=
REPORT_SUPPORT_PASSWORD_HASH=
