# Fill values in an ignored .env. Use a URL-safe database password.
FATE_DB_PASSWORD=
FATE_DATABASE_URL=postgresql+psycopg://fate:REPLACE_ME@db:5432/fate
FATE_ROXY_API_KEY=
FATE_IP_HASH_KEY=
FATE_SUPPORT_EMAIL=


# Use the actual trusted reverse proxy address for production.
FORWARDED_ALLOW_IPS=127.0.0.1
