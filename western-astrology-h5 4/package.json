{
  "name": "astro-thai-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node scripts/serve-flutter.mjs",
    "build": "node scripts/build-flutter.mjs",
    "build:release": "node scripts/build-flutter.mjs release",
    "check": "pnpm check:documents && node scripts/build-flutter.mjs analyze",
    "check:documents": "tsc --noEmit",
    "test": "pnpm test:contracts && pnpm test:flutter",
    "test:contracts": "vitest run",
    "test:flutter": "node scripts/build-flutter.mjs test"
  },
  "dependencies": {
    "pdfmake": "0.3.13"
  },
  "devDependencies": {
    "@types/pdfmake": "0.3.3",
    "esbuild": "0.25.12",
    "typescript": "~5.7.2",
    "vite": "^6.4.1",
    "vitest": "^4.1.12"
  }
}
