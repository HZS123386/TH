{
    # IP clients omit SNI; Docker's private address must not select their certificate.
    default_sni 129.226.126.212
}

# Shared routes keep the existing HTTP entry available for credential migration.
(astro_landing_routes) {
    encode {
        zstd
        gzip 6
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
    redir / /thai-landing/?lang=zh 302

    @landing path /thai-landing /thai-landing/*
    @engineAssets path_regexp engine ^/thai-landing/engine/[a-f0-9]{40}/
    @unversionedAssets {
        not path /thai-landing/engine/*
    }
    handle @landing {
        # SDK-revision URLs are immutable; entry points still revalidate.
        header @unversionedAssets Cache-Control "no-cache"
        header @engineAssets Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy astro-life-report:8000
    }
    @reportApi path /api/life-reports /api/life-reports/* /api/thai-locations /api/landing/*
    handle @reportApi {
        header Cache-Control "no-store"
        reverse_proxy astro-life-report:8000 {
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle /health {
        reverse_proxy astro-life-report:8000
    }
    handle {
        respond 404
    }
}

http://129.226.126.212 {
    import astro_landing_routes
}

https://129.226.126.212 {
    # Public IP certificates require Let's Encrypt's short-lived ACME profile.
    # Caddy manages issuance and renewal in its existing persistent data volume.
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    import astro_landing_routes
}
