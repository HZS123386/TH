# Add this site alongside the existing domain sites in the shared Caddyfile.
http://129.226.126.212 {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
    redir / /thai-landing/?lang=zh 302

    @landing path /thai-landing /thai-landing/*
    handle @landing {
        # Flutter entry points and fonts use stable names; revalidate after releases.
        header Cache-Control "no-cache"
        reverse_proxy astro-life-report:8000
    }
    @reportApi path /api/life-reports /api/life-reports/* /api/thai-locations /api/landing/*
    handle @reportApi {
        header Cache-Control "no-store"
        reverse_proxy astro-life-report:8000 {
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle /health {
        reverse_proxy astro-life-report:8000
    }
    handle {
        respond 404
    }
}
