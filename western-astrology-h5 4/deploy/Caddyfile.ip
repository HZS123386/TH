# Add this site alongside the existing domain sites in the shared Caddyfile.
http://129.226.126.212 {
    encode {
        zstd
        gzip 6
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
    redir / /thai-landing/?lang=zh 302

    @landing path /thai-landing /thai-landing/*
    @engineAssets path_regexp engine ^/thai-landing/engine/[a-f0-9]{40}/
    @unversionedAssets {
        not path /thai-landing/engine/*
    }
    handle @landing {
        # SDK-revision URLs are immutable; entry points still revalidate.
        header @unversionedAssets Cache-Control "no-cache"
        header @engineAssets Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy astro-life-report:8000
    }
    @reportApi path /api/life-reports /api/life-reports/* /api/thai-locations /api/landing/*
    handle @reportApi {
        header Cache-Control "no-store"
        reverse_proxy astro-life-report:8000 {
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle /health {
        reverse_proxy astro-life-report:8000
    }
    handle {
        respond 404
    }
}
